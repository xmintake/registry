{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.stall-book-invoice",
  "schemaVersion": "1.0",
  "title": "Invoice",
  "description": "A supplier invoice, scanned.",
  "fields": {
    "Vendor": {
      "type": "string",
      "label": "Vendor",
      "nullable": true,
      "uiVariant": "single_line"
    },
    "Invoice": {
      "type": "attachment",
      "label": "Invoice",
      "nullable": true,
      "uiVariant": "document_scan",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  },
  "signature": {
    "type": "ed25519",
    "value": "SES8F8OY7YC3HLzsZ5JgEhZEPJ0W0HmN87vbmLdGV4pCULSQAST7aA0Tx6O7VFZNezutTWIPTu2BHPKClbhbDg=="
  }
}
