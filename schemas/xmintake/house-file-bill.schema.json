{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.house-file-bill",
  "schemaVersion": "1.0",
  "title": "Bill",
  "description": "A vendor bill or receipt, scanned.",
  "fields": {
    "Vendor": {
      "type": "string",
      "label": "Vendor",
      "nullable": true,
      "uiVariant": "single_line"
    },
    "Amount": {
      "type": "number",
      "label": "Amount",
      "nullable": true
    },
    "Receipt": {
      "type": "attachment",
      "label": "Receipt",
      "nullable": true,
      "uiVariant": "document_scan",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  }
}
