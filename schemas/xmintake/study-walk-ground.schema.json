{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.study-walk-ground",
  "schemaVersion": "1.0",
  "title": "Ground",
  "description": "A study site: name, pin, and a photo.",
  "fields": {
    "Site": {
      "type": "string",
      "label": "Site",
      "nullable": false,
      "uiVariant": "single_line"
    },
    "Location": {
      "type": "location",
      "label": "Location",
      "nullable": true,
      "location": {
        "exportFormat": "URL"
      }
    },
    "Photo": {
      "type": "attachment",
      "label": "Photo",
      "nullable": true,
      "uiVariant": "photo",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    },
    "Notes": {
      "type": "string",
      "label": "Notes",
      "nullable": true,
      "uiVariant": "multi_line"
    }
  },
  "signature": {
    "type": "ed25519",
    "value": "G76ECuZghaFi3Qv0OxztGBtFY45Cs+lQLicQ+9FBz/s5WnFJMiJXdblUTRRVSaCK3ryI8xN3Pjgh1GoRqUodDQ=="
  }
}
