{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.house-file-clip",
  "schemaVersion": "1.0",
  "title": "Clip",
  "description": "A short video of something a photo does not show, such as a drip.",
  "fields": {
    "Video": {
      "type": "attachment",
      "label": "Video",
      "nullable": true,
      "uiVariant": "video",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Location": {
      "type": "location",
      "label": "Location",
      "nullable": true,
      "location": {
        "exportFormat": "URL"
      }
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  },
  "signature": {
    "type": "ed25519",
    "value": "4EZreTqBwwkASbBvuBZf3co7lUsXO891NmPehFaUtoqkG11tVstsflzmFjaychH/lZSVVqTjhm9XDJdENImfDQ=="
  }
}
