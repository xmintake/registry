{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.study-walk-sample",
  "schemaVersion": "1.0",
  "title": "Sample",
  "description": "A sample: its vial or bag code, where it was found, and a photo.",
  "fields": {
    "Sample code": {
      "type": "string",
      "label": "Sample code",
      "nullable": false,
      "uiVariant": "identifier_code"
    },
    "Location": {
      "type": "location",
      "label": "Location",
      "nullable": true,
      "location": {
        "exportFormat": "URL"
      }
    },
    "Photo": {
      "type": "attachment",
      "label": "Photo",
      "nullable": true,
      "uiVariant": "photo",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Notes": {
      "type": "string",
      "label": "Notes",
      "nullable": true,
      "uiVariant": "multi_line"
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  }
}
