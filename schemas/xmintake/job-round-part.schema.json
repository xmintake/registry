{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.job-round-part",
  "schemaVersion": "1.0",
  "title": "Part",
  "description": "A part used on the job, identified by its code.",
  "fields": {
    "Part code": {
      "type": "string",
      "label": "Part code",
      "nullable": false,
      "uiVariant": "identifier_code"
    },
    "Photo": {
      "type": "attachment",
      "label": "Photo",
      "nullable": true,
      "uiVariant": "photo",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Quantity": {
      "type": "number",
      "label": "Quantity",
      "nullable": true
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  }
}
