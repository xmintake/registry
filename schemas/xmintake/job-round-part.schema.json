{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.job-round-part",
  "schemaVersion": "1.0",
  "title": "Part",
  "description": "A part used on the job, identified by its code.",
  "fields": {
    "Part code": {
      "type": "string",
      "label": "Part code",
      "nullable": false,
      "uiVariant": "identifier_code"
    },
    "Photo": {
      "type": "attachment",
      "label": "Photo",
      "nullable": true,
      "uiVariant": "photo",
      "attachment": {
        "maxFiles": 1,
        "storeInDrive": true,
        "outputFormat": "name+url"
      }
    },
    "Quantity": {
      "type": "number",
      "label": "Quantity",
      "nullable": true
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  },
  "signature": {
    "type": "ed25519",
    "value": "IMsvRMTSNEYnCtFuOuK8BWSgwE8HI5ez1cRtUs7X9YVpHxew9qREB1yUuTp2SBM05R1B4aucgyNHL0VM6X2bCA=="
  }
}
