{
  "$schema": "https://xmintake.github.io/registry/meta/xmintake-schema.v1.json",
  "schemaId": "xmintake.study-walk-note",
  "schemaVersion": "1.0",
  "title": "Note",
  "description": "A field note tied to a subject code, not a full name.",
  "fields": {
    "Subject code": {
      "type": "string",
      "label": "Subject code",
      "nullable": true,
      "uiVariant": "identifier_code"
    },
    "Location": {
      "type": "location",
      "label": "Location",
      "nullable": true,
      "location": {
        "exportFormat": "URL"
      }
    },
    "Notes": {
      "type": "string",
      "label": "Notes",
      "nullable": true,
      "uiVariant": "multi_line"
    },
    "Date": {
      "type": "date",
      "label": "Date",
      "nullable": true
    }
  }
}
